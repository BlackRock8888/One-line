PORT=3000
# Provide a JSON array of RTCIceServer objects. For reliable cross-network calls,
# include STUN and TURN. TURN credentials must be short-lived, issued server-side.
# Do not commit real credentials. Empty defaults only support local connectivity.
ICE_SERVERS_JSON=[]
# Production coturn shared secret; configure the matching secret on coturn.
TURN_URLS=["turns:turn.example.com:443?transport=tcp"]
TURN_SECRET=
# Vercel only: HTTPS address of the single authoritative Node server.
SIGNALING_ORIGIN=https://signal.example.com
# Daily managed voice backend. Server-side only; never expose in public assets.
DAILY_API_KEY=
